# Copy to .env.local for your machine. Only VITE_-prefixed variables reach
# the browser, so nothing secret belongs in this file. Every variable read
# by the app is declared and checked in src/shared/config/env.ts.

# Base URL of the API. Leave unset to run on the mock data in each feature.
VITE_API_URL=

# "true" serves every request from the feature mocks, with no network.
VITE_USE_MOCKS=true
